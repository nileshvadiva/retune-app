# Supabase — from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Stripe — from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxx
STRIPE_PRICE_ULTRA=price_xxxxxxxx
# STRIPE_SECRET_KEY should be sk_test_... while testing, sk_live_... in production

# Cloudflare Turnstile — from dash.cloudflare.com/?to=/:account/turnstile
# The SECRET key (not shown here) goes into Supabase's dashboard instead —
# see README for exact steps.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Base URL of your deployed app (used for Stripe redirect + webhook)
NEXT_PUBLIC_SITE_URL=https://yourapp.com
